# Copy to .env and fill in. .env is gitignored; this file is not.

# OpenAI (D1: OpenAI only for v1) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Postgres with pgvector (Neon or Supabase — open question in progress.md §5)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/regulus?schema=public"

# Daily model budget cap in USD (DESIGN.md §11) — disables expensive paths when exceeded
DAILY_BUDGET_USD=5
