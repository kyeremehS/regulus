# Copy to .env and fill in. .env is gitignored; this file is not.

# Model provider — D1 revised 2026-11-16: OpenRouter free tier by default while
# OpenAI credits are exhausted. Free key (no card): https://openrouter.ai/settings/keys
# Model ids ending in :free are $0/token (20 req/min, 50 req/day; 1,000/day after $10 credits).
OPENROUTER_API_KEY=

# Optional overrides (defaults: openrouter → nemotron-3.5-lightning:free small /
# nemotron-3-ultra-550b-a55b:free large; MODEL_PROVIDER=openai → gpt-5-nano / gpt-5)
# MODEL_PROVIDER=openrouter
# MODEL_SMALL=
# MODEL_LARGE=

# Embeddings — decided 2026-11-26: text-embedding-3-small via OpenRouter ($0.02/M tok,
# ~$0.007 one-time for the whole corpus). 1536 dims — matches the schema's vector(1536).
# Changing the model requires re-embedding the ENTIRE corpus (vectors are not portable).
# MODEL_EMBED=openai/text-embedding-3-small

# OpenAI path (kept for when credits return) — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Postgres with pgvector (Neon or Supabase — open question in progress.md §5)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/regulus?schema=public"

# Daily model budget cap in USD (DESIGN.md §11) — disables expensive paths when exceeded
DAILY_BUDGET_USD=5
